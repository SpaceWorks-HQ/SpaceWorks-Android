<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system trust anchors only (user-installed CAs are not trusted). Debug overrides this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
